{
  "name": "jev-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "main": "dist/main.mjs",
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.98"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "build:native": "bash scripts/build-native.sh",
    "start": "bun dist/cli.mjs",
    "check": "tsc --noEmit",
    "test": "bun test",
    "mcp": "bun dist/cli.mjs mcp",
    "desktop": "electron ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@effect/platform-node": "4.0.0-beta.98",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@typesafe-ai/sdk": "0.6.0",
    "effect": "4.0.0-beta.98",
    "playwright-core": "1.58.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.4.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "jev-desktop": "dist/cli.mjs"
  }
}
