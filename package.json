{
  "name": "@opcodehq/cu",
  "version": "0.2.2",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "main": "dist/main.mjs",
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.98"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "build:native": "bash scripts/build-native.sh",
    "start": "bun dist/cli.mjs",
    "check": "tsc --noEmit",
    "test": "bun test",
    "mcp": "bun dist/cli.mjs mcp",
    "desktop": "bun scripts/desktop.mjs",
    "setup": "bun scripts/setup.mjs",
    "build:cli": "bun scripts/build-cli.mjs",
    "build:linux": "bun scripts/build-linux.mjs",
    "setup:linux": "bun scripts/setup-linux.mjs",
    "desktop:linux": "bun scripts/desktop-linux.mjs",
    "prepack": "bun run build",
    "test:npm": "bun scripts/test-npm-package.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/openai-compatible": "3.0.62",
    "@anthropic-ai/sdk": "0.126.0",
    "@effect/platform-node": "4.0.0-beta.98",
    "@effect/platform-node-shared": "4.0.0-beta.98",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "ai": "7.0.127",
    "effect": "4.0.0-beta.98",
    "onnxruntime-node": "1.30.0",
    "playwright-core": "1.60.0",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.4.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "cu": "bin/cu.mjs",
    "jev": "bin/cu.mjs",
    "jev-desktop": "bin/cu.mjs"
  },
  "description": "Native computer-use CLI and MCP tools for existing coding agents, with browser automation and a live desktop viewer.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opcodehq/computer-use.git"
  },
  "homepage": "https://github.com/opcodehq/computer-use#readme",
  "bugs": {
    "url": "https://github.com/opcodehq/computer-use/issues"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.10"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin/",
    "dist/",
    "src/linux/",
    "native/linux/x11.c",
    "native/macos/*.swift",
    "scripts/install-runtime.mjs",
    "scripts/build-linux.mjs",
    "scripts/build-native.sh",
    "scripts/setup-linux.mjs",
    "scripts/desktop-linux.mjs",
    ".agents/skills/jev-desktop/",
    "docs/",
    "VISION.md",
    "scripts/setup-model.mjs",
    "scripts/setup-macos.mjs"
  ]
}
